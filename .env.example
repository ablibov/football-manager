# Copy to .env (never commit .env). All values below are examples.
POSTGRES_PASSWORD=choose-a-long-random-password
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# 1 behind HTTPS (secure cookies), 0 for plain local HTTP
AZPFL_HTTPS=0
# optional: once HTTPS is confirmed on the final domain
# DJANGO_HSTS_SECONDS=31536000
# optional admin account created at start-up
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
